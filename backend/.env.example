PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/krushi-seva
CLIENT_URL=http://localhost:5173
OTP_EXPIRY_MINUTES=10
RESET_PASSWORD_EXPIRY_MINUTES=15
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password
EMAIL_FROM=Krushi Seva <your_gmail_address@gmail.com>
NODE_ENV=development
JWT_SECRET=generate_with__node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# DEMO OTP MODE: when true, the OTP is shown on the page instead of being sent.
# Use it locally, and on Render while you have no SMS/email service.
# Set to false (or delete) before real users sign up.
ALLOW_DEV_OTP=false

# Optional 
# How long a login lasts. Default 7d.
JWT_EXPIRES_IN=7d
# Secret used to hash OTPs in the database. If empty, JWT_SECRET is used.
OTP_SECRET=

# Optional 
# How much to log: debug, info, warn, error or silent. Default info.
LOG_LEVEL=info
# CLIENT_URL (above) may list several sites separated by commas; * can stand for part of a host name:
# CLIENT_URL=https://krushi-seva.vercel.app,https://krushi-seva-*.vercel.app

